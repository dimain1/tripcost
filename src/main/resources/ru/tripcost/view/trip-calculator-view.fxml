<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.tripcost.view.TripCalculatorView"
      spacing="24">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- ===== Форма ввода ===== -->
    <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="420">
        <Label text="Шаблон поездки" styleClass="section-title"/>
        <HBox spacing="8">
            <ComboBox fx:id="templateBox" promptText="Выберите шаблон" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Заполнить" onAction="#onApplyTemplate"/>
        </HBox>
        <HBox spacing="8">
            <TextField fx:id="templateNameField" promptText="Название нового шаблона" HBox.hgrow="ALWAYS"/>
            <Button text="Сохранить как шаблон" onAction="#onSaveTemplate"/>
            <Button fx:id="deleteTemplateButton" text="Удалить шаблон"/>
        </HBox>
        <Label fx:id="templatesHintLabel" styleClass="hint" wrapText="true"/>

        <Separator/>
        <Label text="Параметры поездки" styleClass="section-title"/>

        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="170"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Откуда" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="originField" promptText="Город отправления"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Куда" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="destinationField" promptText="Город назначения"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Расстояние, км" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <HBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <TextField fx:id="distanceField" promptText="в одну сторону" HBox.hgrow="ALWAYS"/>
                <Button fx:id="lookupButton" text="Определить" onAction="#onLookupDistance"/>
            </HBox>

            <Label text="Транспорт" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="transportBox" maxWidth="Infinity"
                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Пассажиров" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Spinner fx:id="passengersSpinner" editable="true" maxWidth="Infinity"
                     GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Расход, л/100 км" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="fuelField" promptText="по умолчанию из настроек"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Платные дороги, ₽" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="tollsField" promptText="в одну сторону"
                       GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Ночей в гостинице" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <TextField fx:id="nightsField" promptText="0"
                       GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <Label text="Цена за ночь, ₽" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <TextField fx:id="priceNightField" promptText="за номер"
                       GridPane.rowIndex="8" GridPane.columnIndex="1"/>

            <CheckBox fx:id="roundTripBox" text="Туда и обратно"
                      GridPane.rowIndex="9" GridPane.columnIndex="1"/>

            <Label text="Доп. услуги" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
            <FlowPane fx:id="optionsPane" hgap="12" vgap="6"
                      GridPane.rowIndex="10" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox spacing="8">
            <Button text="Рассчитать" defaultButton="true" onAction="#onCalculate" styleClass="primary"/>
            <Button text="Сравнить транспорт" onAction="#onCompare"/>
            <Button text="Очистить" onAction="#onClear"/>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error" wrapText="true" maxWidth="Infinity"/>
        <Label fx:id="infoLabel" styleClass="info" wrapText="true" maxWidth="Infinity"/>
    </VBox>

    <!-- ===== Результат ===== -->
    <VBox spacing="16" minWidth="440" prefWidth="460">
        <VBox spacing="10" styleClass="result-card">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="Стоимость поездки" styleClass="section-title"/>
            <Label fx:id="summaryLabel" styleClass="hint" wrapText="true"/>

            <TreeTableView fx:id="costTable" prefHeight="170" showRoot="true">
                <placeholder>
                    <Label text="Статьи расходов появятся после расчёта" styleClass="hint"/>
                </placeholder>
                <columnResizePolicy>
                    <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TreeTableColumn fx:id="costNameColumn" text="Статья расходов" prefWidth="250"/>
                    <TreeTableColumn fx:id="costAmountColumn" text="Сумма" prefWidth="140" styleClass="amount"/>
                </columns>
            </TreeTableView>

            <Separator/>

            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS" halignment="RIGHT"/>
                </columnConstraints>

                <Label text="Итого" styleClass="total" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="totalCostLabel" styleClass="total" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="На одного пассажира" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="perPassengerLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="В пути" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="travelTimeLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Согласование" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="approvalLabel" styleClass="approval" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Label fx:id="approvalDetailsLabel" styleClass="hint" wrapText="true"/>

            <Separator/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Отчёт"/>
                <ComboBox fx:id="reportTypeBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="reportFormatBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <FlowPane hgap="8" vgap="6">
                <Button fx:id="previewButton" text="Просмотр" onAction="#onPreviewReport"/>
                <Button fx:id="saveReportButton" text="Сохранить в файл…" onAction="#onSaveReport"/>
                <Button fx:id="addToJourneyButton" text="В маршрут" onAction="#onAddToJourney"/>
                <Button fx:id="createRequestButton" text="Оформить заявку" onAction="#onCreateRequest"/>
            </FlowPane>
        </VBox>

        <!-- ===== Сравнение видов транспорта ===== -->
        <VBox spacing="8" styleClass="result-card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <Label text="Сравнение видов транспорта" styleClass="section-title"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Критерий"/>
                <ComboBox fx:id="choiceBox" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <TableView fx:id="variantsTable" VBox.vgrow="ALWAYS" prefHeight="150">
                <placeholder>
                    <Label text="Нажмите «Сравнить транспорт»" styleClass="hint"/>
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="variantTransportColumn" text="Транспорт" prefWidth="120"/>
                    <TableColumn fx:id="variantTotalColumn" text="Итого" prefWidth="95"/>
                    <TableColumn fx:id="variantTimeColumn" text="В пути" prefWidth="95"/>
                    <TableColumn fx:id="variantNoteColumn" text="Примечание" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
